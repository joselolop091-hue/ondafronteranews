<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔴 EN VIVO — Onda Frontera</title>
    <style>
        * {margin: 0; padding: 0; box-sizing: border-box;}
        body {
            background: linear-gradient(135deg, #0f1e33 0%, #1a3555 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            gap: 18px;
        }
        .logo-imagen {
            width: 100%;
            max-width: 500px;
            height: auto;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            border: 2px solid rgba(255,215,0,0.25);
            margin-top: 10px;
        }
        .player-box {
            width: 100%;
            max-width: 295px;
            background: rgba(0,0,0,0.65);
            padding: 17px 11px;
            border-radius: 14px;
            box-shadow: 0 6px 21px rgba(0,0,0,0.4);
            border: 1px solid rgba(255,215,0,0.2);
            text-align: center;
        }
        .titulo-reproductor {
            color: #ffd700;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 11px;
            letter-spacing: 1px;
            line-height: 1.4;
        }
        .live-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(220,20,60,0.9);
            color: white;
            font-size: 9px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 50px;
            margin-bottom: 12px;
            animation: pulse 2s infinite;
        }
        .live-dot {
            width: 6px; height: 6px;
            background: white;
            border-radius: 50%;
            animation: blink 1s infinite alternate;
        }
        @keyframes pulse {
            0%,100%{box-shadow:0 0 15px rgba(220,20,60,0.4);}
            50%{box-shadow:0 0 25px rgba(220,20,60,0.6);}
        }
        @keyframes blink {
            0%{opacity:1;}
            100%{opacity:0.3;}
        }
        .reproductor-centro {
            display: flex; flex-direction: column;
            align-items: center; margin: 7px 0;
        }
        .boton-play-triangulo {
            width: 44px; height: 44px; border: none;
            background: linear-gradient(135deg,#1a73e8 0%,#0d47a1 100%);
            border-radius: 50%; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 3px 13px rgba(26,115,232,0.4);
        }
        .boton-play-triangulo:active {transform: scale(0.95);}
        .triangulo {
            width:0; height:0;
            border-top:10px solid transparent;
            border-bottom:10px solid transparent;
            border-left:15px solid white;
            margin-left: 3px;
        }
        .boton-play-triangulo.reproduciendo .triangulo {
            border: none; width:13px; height:15px;
            background: white;
            clip-path: polygon(0 0,35% 0,35% 100%,0 100%,65% 0,100% 0,100% 100%,65% 100%);
        }
        audio {display: none;}
        .separador {
            width:60%; height:1px;
            background: linear-gradient(90deg,transparent,rgba(255,215,0,0.4),transparent);
            margin:7px auto;
        }
        .chat-box {
            width:100%; max-width:295px;
            background: rgba(0,0,0,0.65);
            padding:15px; border-radius:14px;
            border:1px solid rgba(255,215,0,0.2);
            display:flex; flex-direction:column; gap:10px;
        }
        .chat-titulo {
            color:#ffd700; font-size:12px; font-weight:700; text-align:center;
        }
        .chat-estado {color:#4ade80; font-size:10px; text-align:center;}
        .chat-mensajes {
            height:150px; background:rgba(10,22,40,0.6);
            border-radius:10px; padding:10px; overflow-y:auto;
            display:flex; flex-direction:column; gap:6px;
        }
        .mensaje {
            color:#e6f0ff; font-size:11px;
            padding:6px 10px; background:rgba(26,115,232,0.15);
            border-radius:8px; border-left:2px solid #1a73e8;
        }
        .mensaje .nombre {color:#ffd700; font-weight:700; font-size:10px;}
        .chat-input-area {display:flex; gap:6px;}
        .chat-input {
            flex:1; padding:8px 10px;
            background:rgba(10,22,40,0.6); border:1px solid rgba(255,215,0,0.2);
            border-radius:8px; color:white; font-size:11px; outline:none;
        }
        .chat-boton {
            padding:8px 14px;
            background:linear-gradient(135deg,#1a73e8 0%,#0d47a1 100%);
            color:white; border:none; border-radius:8px;
            font-size:11px; font-weight:700; cursor:pointer;
        }
    </style>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDPuInhVZGGfXnGDFC_JQrzFA-s6g_yNzo",
            authDomain: "onda-frontera.firebaseapp.com",
            projectId: "onda-frontera",
            storageBucket: "onda-frontera.appspot.com",
            messagingSenderId: "1064419246682",
            appId: "1:1064419246682:web:d5a2f818b03e3b99b48e63",
            measurementId: "G-SLLXS2MJ0R"
        };
        const app = firebase.initializeApp(firebaseConfig);
        const db = firebase.database(app);
    </script>
</head>
<body>

    <img src="https://github.com/milanmilano12222-stack/Ondafrontera/raw/main/IMG-20260818-WA0039.jpg" alt="Onda Frontera" class="logo-imagen">

    <div class="player-box">
        <div class="live-badge"><span class="live-dot"></span> EN VIVO AHORA</div>
        <p class="titulo-reproductor">📡 Transmisión en Vivo</p>
        <div class="reproductor-centro">
            <button class="boton-play-triangulo" id="botonPlay1"><div class="triangulo"></div></button>
            <audio id="audio1">
                <source src="https://stream-291.surfernetwork.com/kd0p50swchruv?zt=eyJhbGciOiJIUzI1NiJ9.eyJzdHJlYW0iOiJrZDBwNTBzd2NocnV2IiwiaG9zdCI6InN0cmVhbS0yOTEuc3VyZmVybmV0d29yay5jb20iLCJydHRsIjo1LCJqdGkiOiJzcS1hRlVjNlIzZS1adE5QVXVxTVhBIiwiaWF0IjoxNzg3MTM3OTA1LCJleHAiOjE3ODcxMzc5NjV9.wKG5auIWgC-3EqzyHxAw4_MEIqRQTXGZYOSormpeRaM" type="audio/mpeg">
            
        </div>
    </div>

    <div class="separador"></div>

    <div class="player-box">
        <p class="titulo-reproductor">🎙️ Transmisión Marcos Velázquez<br>15 de Agosto</p>
        <div class="reproductor-centro">
            <button class="boton-play-triangulo" id="botonPlay2"><div class="triangulo"></div></button>
            <audio id="audio2">
                <source src="https://github.com/joselolop091-hue/primeratransmisionmarcosvelazques/raw/main/WhatsApp%20Audio%202026-08-20%20at%204.30.45%20PM.ogg" type="audio/ogg">
            
        </div>
    </div>

    <div class="separador"></div>

    <div class="chat-box">
        <h3 class="chat-titulo">💬 CHAT EN VIVO</h3>
        <p class="chat-estado">✅ Conectado — todos ven los mensajes</p>
        <div class="chat-mensajes" id="chatMensajes">
            <div class="mensaje"><span class="nombre">📻 Onda Frontera:</span> ¡Bienvenidos! Escriban y todos lo verán 🎧</div>
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="nombreUsuario" placeholder="Tu nombre..." maxlength="12">
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="mensajeEntrada" placeholder="Escribe tu mensaje..." maxlength="80">
            <button class="chat-boton" id="botonEnviar">Enviar</button>
        </div>
    </div>

    <script>
        const audio1 = document.getElementById('audio1');
        const botonPlay1 = document.getElementById('botonPlay1');
        botonPlay1.onclick = () => {
            if (audio1.paused) { audio1.play(); botonPlay1.classList.add('reproduciendo'); audio2.pause(); botonPlay2.classList.remove('reproduciendo'); }
            else { audio1.pause(); botonPlay1.classList.remove('reproduciendo'); }
        };

        const audio2 = document.getElementById('audio2');
        const botonPlay2 = document.getElementById('botonPlay2');
        botonPlay2.onclick = () => {
            if (audio2.paused) { audio2.play(); botonPlay2.classList.add('reproduciendo'); audio1.pause(); botonPlay1.classList.remove('reproduciendo'); }
            else { audio2.pause(); botonPlay2.classList.remove('reproduciendo'); }
        };

        const cajaMensajes = document.getElementById('chatMensajes');
        const mensajeEntrada = document.getElementById('mensajeEntrada');
        const nombreUsuario = document.getElementById('nombreUsuario');
        const botonEnviar = document.getElementById('botonEnviar');
        const mensajesRef = db.ref('mensajes');

        mensajesRef.on('child_added', (snapshot) => {
            const msg = snapshot.val();
            const div = document.createElement('div');
            div.className = 'mensaje';
            div.innerHTML = `<span class="nombre">${msg.nombre}:</span> ${msg.texto}`;
            cajaMensajes.appendChild(div);
            cajaMensajes.scrollTop = cajaMensajes.scrollHeight;
        });

        function enviarMensaje() {
            const nombre = nombreUsuario.value.trim() || 'Invitado';
            const texto = mensajeEntrada.value.trim();
            if (texto) { mensajesRef.push({ nombre, texto }); mensajeEntrada.value = ''; }
        }

        botonEnviar.onclick = enviarMensaje;
        mensajeEntrada.onkeypress = (e) => e.key === 'Enter' && enviarMensaje();
    </script>

</body>
</html>
